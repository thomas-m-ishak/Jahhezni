@model Jahhezni.Models.User

@{
    ViewData["Title"] = "إنشاء حساب جديد";
}

<link rel="stylesheet" href="~/css/register.css" />

<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;" dir="rtl">

    <div class="card shadow border-0" style="width:100%; max-width:500px; border-radius:15px;">

        <div class="card-body p-4">

            <div class="text-center mb-4">
                <h3 class="fw-bold" style="color:#ff69b4;">
                    إنشاء حساب جديد ❤️
                </h3>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post" id="registerForm" autocomplete="off">

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-bold">الاسم الكامل</label>
                        <input asp-for="Name" class="form-control" placeholder="الاسم" required autocomplete="off" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-bold">رقم الهاتف</label>
                        <input asp-for="Phone" id="phoneInput" type="tel" maxlength="11" class="form-control" placeholder="010..." required autocomplete="off" />
                        <div id="phoneError" class="text-danger small mt-1" style="display:none;">يجب أن يكون 11 رقم ويبدأ بـ (010, 011, 012, 015)</div>
                    </div>

                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">البريد الإلكتروني</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="roma@example.com" required autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">المحافظة</label>
                    <select asp-for="Address" class="form-select text-end" required>
                        <option value="" disabled selected hidden>اختر المحافظة...</option>
                        <option value="القاهرة">القاهرة</option>
                        <option value="الجيزة">الجيزة</option>
                        <option value="الإسكندرية">الإسكندرية</option>
                        <option value="القليوبية">القليوبية</option>
                        <option value="الدقهلية">الدقهلية</option>
                        <option value="الشرقية">الشرقية</option>
                        <option value="المنوفية">المنوفية</option>
                        <option value="الغربية">الغربية</option>
                        <option value="دمياط">دمياط</option>
                        <option value="البحيرة">البحيرة</option>
                        <option value="كفر الشيخ">كفر الشيخ</option>
                        <option value="بور سعيد">بور سعيد</option>
                        <option value="الإسماعيلية">الإسماعيلية</option>
                        <option value="السويس">السويس</option>
                        <option value="الفيوم">الفيوم</option>
                        <option value="بني سويف">بني سويف</option>
                        <option value="المنيا">المنيا</option>
                        <option value="أسيوط">أسيوط</option>
                        <option value="سوهاج">سوهاج</option>
                        <option value="قنا">قنا</option>
                        <option value="الأقصر">الأقصر</option>
                        <option value="أسوان">أسوان</option>
                        <option value="البحر الأحمر">البحر الأحمر</option>
                        <option value="الوادي الجديد">الوادي الجديد</option>
                        <option value="مطروح">مطروح</option>
                        <option value="شمال سيناء">شمال سيناء</option>
                        <option value="جنوب سيناء">جنوب سيناء</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">كلمة المرور</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required autocomplete="new-password" />
                </div>

                <div class="mb-3">

                    <label class="form-label small fw-bold">
                        نوع الحساب
                    </label>

                    <select asp-for="Role"
                            class="form-select"
                            id="roleSelect">

                        <option value="Bride" selected>
                            مشتري
                        </option>

                        <option value="Vendor">
                            بائع
                        </option>

                    </select>

                </div>

                <div id="vendorFields" style="display:none;">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">اسم المتجر</label>
                        <input type="text" name="MerchantName" id="merchantNameInput" class="form-control" placeholder="اسم المتجر" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">القسم</label>
                        <select name="Category" class="form-select">
                            <option value="Electronic devices">أجهزة كهربائية</option>
                            <option value="Furniture">أثاث</option>
                            <option value="Kitchen">مطبخ</option>
                            <option value="Clothing">ملابس</option>
                            <option value="Appliances">أدوات منزلية</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn w-100 fw-bold py-2 shadow-sm" style="background-color:#ff69b4; color:white; border-radius:8px;">
                    سجلي الآن
                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/register.js"></script>
}
